{
 "name": "squilo",
 "version": "0.7.0-beta.1",
 "description": "Bun-first TypeScript library for orchestrating SQL Server connections, authentication, and script execution",
 "keywords": [
  "sql-server",
  "mssql",
  "database",
  "multi-tenant",
  "etl",
  "pipeline",
  "bun",
  "typescript",
  "tanstack-intent"
 ],
 "type": "module",
 "files": [
  "dist",
  "skills"
 ],
 "module": "./dist/index.js",
 "types": "./dist/index.d.ts",
 "exports": {
  ".": {
   "import": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
   }
  },
  "./package.json": "./package.json"
 },
 "publishConfig": {
  "access": "public"
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/dodevs/Squilo.git"
 },
 "author": {
  "name": "Douglas da Silva Sousa",
  "email": "douglass.sousa@outlook.com.br"
 },
 "scripts": {
  "test": "bun test",
  "test:watch": "bun test --watch",
  "build": "bunup"
 },
 "devDependencies": {
  "@faker-js/faker": "^10.1.0",
  "@tanstack/intent": "latest",
  "@types/bun": "latest",
  "@types/cli-progress": "^3.11.6",
  "testcontainers": "^11.7.1"
 },
 "peerDependencies": {
  "typescript": "^5.9.3"
 },
 "dependencies": {
  "@types/mssql": "^9.1.8",
  "cli-progress": "^3.12.0",
  "effect": "^4.0.1",
  "mssql": "^12.2.0"
 },
 "license": "MIT"
}
